{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Turtle",
	"scopeName": "source.turtle",
	"fileTypes": ["ttl"],
	"patterns": [
		{
			"include": "#comment"
		},
		{
			"include": "#directive"
		},
		{
			"include": "#sparql-directive"
		},
		{
			"include": "#sparql-version"
		},
		{
			"include": "#triple-content"
		}
	],
	"repository": {
		"comment": {
			"match": "(#).*$",
			"name": "comment.line.number-sign.turtle",
			"captures": {
				"1": {
					"name": "punctuation.definition.comment.turtle"
				}
			}
		},
		"directive": {
			"begin": "(@prefix|@base|@version)\\b",
			"beginCaptures": {
				"1": {
					"name": "keyword.other.directive.turtle"
				}
			},
			"end": "\\.",
			"endCaptures": {
				"0": {
					"name": "punctuation.terminator.directive.turtle"
				}
			},
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#version-string"
				},
				{
					"include": "#prefix-declaration"
				},
				{
					"include": "#iri"
				}
			]
		},
		"sparql-directive": {
			"begin": "(?i)(?<![\\p{L}\\p{N}_:.\\-])(PREFIX|BASE)(?![\\p{L}\\p{N}_:.\\-])",
			"beginCaptures": {
				"1": {
					"name": "keyword.other.directive.turtle"
				}
			},
			"end": "(?<=>)",
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#prefix-declaration"
				},
				{
					"include": "#iri"
				}
			]
		},
		"prefix-declaration": {
			"match": "([\\p{L}](?:[\\p{L}\\p{N}_\\-·]|\\.(?=[\\p{L}\\p{N}_\\-·]))*)?(:)",
			"captures": {
				"1": {
					"name": "entity.name.namespace.turtle"
				},
				"2": {
					"name": "punctuation.separator.prefix.turtle"
				}
			}
		},
		"triple-content": {
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#string-long-double"
				},
				{
					"include": "#string-long-single"
				},
				{
					"include": "#string-double"
				},
				{
					"include": "#string-single"
				},
				{
					"include": "#rdf12"
				},
				{
					"include": "#iri"
				},
				{
					"include": "#blank-node-label"
				},
				{
					"include": "#keyword-a"
				},
				{
					"include": "#boolean"
				},
				{
					"include": "#number"
				},
				{
					"include": "#prefixed-name"
				},
				{
					"include": "#punctuation"
				}
			]
		},
		"iri": {
			"match": "(<)([^<>\"{}|^`\\\\\\s]*)(>)",
			"name": "markup.underline.link.iri.turtle",
			"captures": {
				"1": {
					"name": "punctuation.definition.iri.begin.turtle"
				},
				"2": {
					"name": "string.other.iri.turtle"
				},
				"3": {
					"name": "punctuation.definition.iri.end.turtle"
				}
			}
		},
		"prefixed-name": {
			"match": "([\\p{L}](?:[\\p{L}\\p{N}_\\-·]|\\.(?=[\\p{L}\\p{N}_\\-·]))*)?(:)((?:[\\p{L}\\p{N}_:%\\-·]|\\\\[_~.!$&'()*+,;=/?#@%\\-]|\\.(?=(?:[\\p{L}\\p{N}_:%\\-·]|\\\\[_~.!$&'()*+,;=/?#@%\\-])))*)",
			"captures": {
				"1": {
					"name": "entity.name.namespace.turtle"
				},
				"2": {
					"name": "punctuation.separator.prefix.turtle"
				},
				"3": {
					"name": "entity.name.tag.local.turtle"
				}
			}
		},
		"blank-node-label": {
			"match": "(_:)([\\p{L}\\p{N}_](?:[\\p{L}\\p{N}_\\-·]|\\.(?=[\\p{L}\\p{N}_\\-·]))*)",
			"captures": {
				"1": {
					"name": "punctuation.definition.blank-node.turtle"
				},
				"2": {
					"name": "variable.other.blank-node.turtle"
				}
			}
		},
		"keyword-a": {
			"match": "(?<![\\p{L}\\p{N}_:\\-])a(?![\\p{L}\\p{N}_:\\-])",
			"name": "keyword.other.type.turtle"
		},
		"boolean": {
			"match": "(?<![\\p{L}\\p{N}_:\\-])(true|false)(?![\\p{L}\\p{N}_:\\-])",
			"name": "constant.language.boolean.turtle"
		},
		"number": {
			"match": "(?<![\\w:.-])[+-]?(?:\\d+\\.?\\d*[eE][+-]?\\d+|\\.\\d+[eE][+-]?\\d+|\\d*\\.\\d+|\\d+)(?![\\w:])",
			"name": "constant.numeric.turtle"
		},
		"string-escapes": {
			"match": "\\\\(?:[tbnrf\"'\\\\]|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8})",
			"name": "constant.character.escape.turtle"
		},
		"string-long-double": {
			"begin": "\"\"\"",
			"end": "\"\"\"(?!\")",
			"name": "string.quoted.triple.double.turtle",
			"patterns": [
				{
					"include": "#string-escapes"
				}
			]
		},
		"string-long-single": {
			"begin": "'''",
			"end": "'''(?!')",
			"name": "string.quoted.triple.single.turtle",
			"patterns": [
				{
					"include": "#string-escapes"
				}
			]
		},
		"string-double": {
			"begin": "\"",
			"end": "\"|$",
			"name": "string.quoted.double.turtle",
			"patterns": [
				{
					"include": "#string-escapes"
				}
			]
		},
		"string-single": {
			"begin": "'",
			"end": "'|$",
			"name": "string.quoted.single.turtle",
			"patterns": [
				{
					"include": "#string-escapes"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"match": "(@)([A-Za-z]+(?:-[A-Za-z0-9]+)*)(?:(--)([A-Za-z]+))?",
					"captures": {
						"1": {
							"name": "punctuation.definition.language-tag.turtle"
						},
						"2": {
							"name": "constant.language.language-tag.turtle"
						},
						"3": {
							"name": "punctuation.separator.direction.turtle"
						},
						"4": {
							"name": "constant.language.direction.turtle"
						}
					}
				},
				{
					"match": "\\^\\^",
					"name": "keyword.operator.datatype.turtle"
				},
				{
					"match": "\\.",
					"name": "punctuation.terminator.statement.turtle"
				},
				{
					"match": ";",
					"name": "punctuation.separator.predicate.turtle"
				},
				{
					"match": ",",
					"name": "punctuation.separator.object.turtle"
				},
				{
					"match": "[\\[\\]]",
					"name": "punctuation.section.blank-node.turtle"
				},
				{
					"match": "[()]",
					"name": "punctuation.section.collection.turtle"
				}
			]
		},
		"sparql-version": {
			"begin": "(?i)(?<![\\p{L}\\p{N}_:.\\-])(VERSION)(?![\\p{L}\\p{N}_:.\\-])",
			"beginCaptures": {
				"1": {
					"name": "keyword.other.directive.turtle"
				}
			},
			"end": "(?<=[\\\"'])",
			"patterns": [
				{
					"include": "#comment"
				},
				{
					"include": "#version-string"
				}
			]
		},
		"version-string": {
			"match": "\\\"[^\\\"\\\\\\n]*\\\"|'[^'\\\\\\n]*'",
			"name": "string.quoted.version.turtle"
		},
		"rdf12": {
			"comment": "RDF 1.2: triple terms <<( s p o )>>, reified triples << s p o ~ r >>, annotations {| p o |}",
			"patterns": [
				{
					"match": "<<\\(|\\)>>",
					"name": "punctuation.section.triple-term.turtle"
				},
				{
					"match": "<<|>>",
					"name": "punctuation.section.reified-triple.turtle"
				},
				{
					"match": "\\{\\||\\|\\}",
					"name": "punctuation.section.annotation.turtle"
				},
				{
					"match": "~",
					"name": "keyword.operator.reifier.turtle"
				}
			]
		}
	}
}
