{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "npm",
			"script": "build",
			"group": { "kind": "build", "isDefault": true },
			"problemMatcher": "$esbuild"
		},
		{
			"type": "npm",
			"script": "watch",
			"isBackground": true,
			"problemMatcher": "$esbuild-watch"
		},
		{
			"label": "build integration tests",
			"type": "shell",
			"command": "node esbuild.mjs && npx tsc -p test/integration",
			"problemMatcher": "$tsc"
		}
	]
}
